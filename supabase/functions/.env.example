# ─── DPO Group (Direct Pay Online) credentials ───────────────────────────────
# Register at https://www.dpogroup.com or contact sales for Namibia onboarding.
# The demo token below is DPO's publicly documented test token — works for
# sandbox testing without a merchant account.

# Demo / test (default if secret is not set in Edge Function):
DPO_COMPANY_TOKEN=8D3DA73D-9D7F-4E09-96D4-3D44E7A83EA3
DPO_SERVICE_TYPE=45

# Production (replace with values from your DPO merchant dashboard):
# DPO_COMPANY_TOKEN=YOUR_REAL_COMPANY_TOKEN
# DPO_SERVICE_TYPE=YOUR_SERVICE_TYPE_CODE

# Return URLs intercepted by DPOWebView.js — keep in sync with DPOService.js
DPO_REDIRECT_URL=https://app.eshoppit.com/payment-result
DPO_BACK_URL=https://app.eshoppit.com/payment-cancelled

# ─── Test card numbers (DPO demo environment) ────────────────────────────────
# Visa:       4111 1111 1111 1111 | any future expiry | any CVV
# Mastercard: 5555 5555 5555 4444 | any future expiry | any CVV
